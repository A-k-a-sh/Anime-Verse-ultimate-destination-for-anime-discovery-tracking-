# Server Configuration
PORT=3000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/anime-site

# JWT Secret (change this to a random secure string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Jikan API
JIKAN_API_URL=https://api.jikan.moe/v4

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Cloudinary Media Pipeline (Otaku Pulse)
# Option A: Full Cloudinary URL
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# Option B: Discrete credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Otaku Pulse Moderation (comma-separated list of platform admin emails)
ADMIN_EMAILS=admin@example.com,moderator@example.com
